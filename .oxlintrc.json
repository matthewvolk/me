{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "nextjs", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [".next", "dist", "build"]
}
